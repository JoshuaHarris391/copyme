{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character Card V2",
  "description": "The published Character Card V2 specification, as read by SillyTavern and compatible front ends. Checked in as a fixture so card validation needs no network access.",
  "type": "object",
  "required": ["spec", "spec_version", "data"],
  "properties": {
    "spec": {
      "type": "string",
      "const": "chara_card_v2"
    },
    "spec_version": {
      "type": "string",
      "const": "2.0"
    },
    "data": {
      "type": "object",
      "required": [
        "name",
        "description",
        "personality",
        "scenario",
        "first_mes",
        "mes_example",
        "creator_notes",
        "system_prompt",
        "post_history_instructions",
        "alternate_greetings",
        "tags",
        "creator",
        "character_version",
        "extensions"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "personality": { "type": "string" },
        "scenario": { "type": "string" },
        "first_mes": { "type": "string" },
        "mes_example": { "type": "string" },
        "creator_notes": { "type": "string" },
        "system_prompt": { "type": "string" },
        "post_history_instructions": { "type": "string" },
        "alternate_greetings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "character_book": {
          "type": ["object", "null"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "creator": { "type": "string" },
        "character_version": { "type": "string" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
